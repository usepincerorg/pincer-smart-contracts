# Deployer key used by Bootstrap and DemoData. It becomes the PincerDeployer owner and, if the two optional
# overrides further down stay blank, also receives fees and serves as the default verifier.
PRIVATE_KEY=

# RPC endpoints, referenced by the robinhood_testnet and robinhood aliases in foundry.toml. The public endpoints
# are rate limited and fine for roughly one deployment; switch to a dedicated provider (Alchemy or similar) beyond that.
#   Robinhood Chain testnet, chain id 46630: https://rpc.testnet.chain.robinhood.com
#   Robinhood Chain mainnet, chain id 4663:  https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC=

# Blockscout endpoints used by --verify. Blockscout needs no real key, but forge expects some value to be present.
ROBINHOOD_TESTNET_BLOCKSCOUT_API=https://explorer.testnet.chain.robinhood.com/api
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api
BLOCKSCOUT_API_KEY=unused

# Settlement stablecoin for offerings, trading windows, quote fills and payouts. It must be filled in on mainnet.
# Anywhere else, leaving it blank makes Bootstrap deploy TestDollar, a 6-decimal token with open minting.
USDG=

# Optional overrides. Blank means the deployer address is used.
FEE_RECIPIENT=
DEFAULT_VERIFIER=

# Adds the fictional Larkway Labs company to the deployment. When unset, it is on for every chain except mainnet.
DEPLOY_DEMO=true
